{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "evals-mcp-server",
  "version": "0.1.3",
  "description": "Author verifiable eval records through a draft → review → revise → submit loop with server-enforced graders; compile to JSONL/CSV/Inspect/lm-eval via MCP. STDIO or Streamable HTTP.",
  "author": {
    "name": "cyanheads",
    "email": "casey@caseyjhand.com",
    "url": "https://github.com/cyanheads"
  },
  "homepage": "https://github.com/cyanheads/evals-mcp-server",
  "repository": "https://github.com/cyanheads/evals-mcp-server",
  "license": "Apache-2.0",
  "keywords": ["mcp", "mcp-server", "model-context-protocol", "evals", "evaluation", "grader", "rlvr"],
  "mcpServers": {
    "evals-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/evals-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "EVALS_DATA_DIR": "${EVALS_DATA_DIR}"
      }
    }
  }
}
